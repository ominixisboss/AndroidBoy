<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.AndroidBoy" parent="@android:style/Theme.Material.Light.DarkActionBar">
        <item name="android:colorPrimary">#2F3E8C</item>
        <item name="android:colorPrimaryDark">#1F2A61</item>
        <item name="android:colorAccent">#8C1F5B</item>
    </style>

    <!-- The game library: dark, like the in-game menu, with its own header instead of an action bar. -->
    <style name="Theme.AndroidBoy.Library" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/library_background</item>
        <item name="android:statusBarColor">@color/library_background</item>
        <item name="android:navigationBarColor">@color/library_background</item>
        <item name="android:colorPrimary">#2F3E8C</item>
        <item name="android:colorAccent">#E0508C</item>
    </style>

    <style name="Theme.AndroidBoy.Game" parent="@android:style/Theme.Material.NoActionBar.Fullscreen">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:colorAccent">#8C1F5B</item>
    </style>
</resources>
