<?xml version="1.0" encoding="utf-8"?>
<!-- Cloud backups and device transfers (Android 12 and later) leave out the RetroAchievements login token. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="retroachievements.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="retroachievements.xml" />
    </device-transfer>
</data-extraction-rules>
